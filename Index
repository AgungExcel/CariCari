<!DOCTYPE html>
<html>
<head>
  <base target="_top">

  <script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

  <style>
    :root {
      --primary: #0f172a;
      --accent: #2563eb;
      --accent-soft: #eff6ff;
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #111827;
      --muted: #6b7280;
      --line: #e5e7eb;

      --blue: #2563eb;
      --green: #059669;
      --red: #dc2626;
      --amber: #d97706;
      --purple: #7c3aed;
      --cyan: #0891b2;

      --blue-bg: #eff6ff;
      --green-bg: #ecfdf5;
      --red-bg: #fef2f2;
      --amber-bg: #fffbeb;
      --purple-bg: #f5f3ff;
      --cyan-bg: #ecfeff;

      --blue-line: #bfdbfe;
      --green-line: #bbf7d0;
      --red-line: #fecaca;
      --amber-line: #fde68a;
      --purple-line: #ddd6fe;
      --cyan-line: #a5f3fc;

      --gray-bg: #f3f4f6;
      --gray-line: #e5e7eb;

      --shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      min-height: 100%;
      font-family: Arial, sans-serif;
      color: var(--text);
      background: var(--bg);
      overflow: hidden;
    }

    body.lock-scroll {
      overflow: hidden;
    }

    .app {
      width: 100%;
      height: 100vh;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background: var(--bg);
      overflow: hidden;
    }

    .topbar {
      width: 100%;
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 12px 22px;
      background: var(--card);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
      flex: 0 0 auto;
      z-index: 20;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 13px;
      min-width: 260px;
    }

    .logo {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: linear-gradient(135deg, #2563eb, #0f172a);
      display: grid;
      place-items: center;
      color: #ffffff;
      font-weight: 900;
      font-size: 17px;
      overflow: hidden;
      flex: 0 0 auto;
    }

    .logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .brand-title {
      margin: 0;
      font-size: 20px;
      font-weight: 900;
      line-height: 1.2;
      color: var(--primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .brand-subtitle {
      margin: 3px 0 0;
      font-size: 12px;
      color: var(--muted);
    }

    .header-stats {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-left: auto;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .header-stat {
      min-width: 86px;
      padding: 8px 10px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #ffffff;
      box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
    }

    .header-stat span {
      display: block;
      color: var(--muted);
      font-size: 9px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 3px;
    }

    .header-stat strong {
      display: block;
      color: var(--primary);
      font-size: 20px;
      line-height: 1;
      font-weight: 900;
    }

    .header-stat.blue strong {
      color: var(--blue);
    }

    .header-stat.green strong {
      color: var(--green);
    }

    .header-stat.amber strong {
      color: var(--amber);
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .icon-btn {
      border: none;
      border-radius: 14px;
      width: 42px;
      height: 42px;
      padding: 0;
      cursor: pointer;
      font-weight: 800;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      color: #ffffff;
      display: inline-grid;
      place-items: center;
      white-space: nowrap;
      transition: 0.15s ease;
      box-shadow: 0 9px 20px rgba(37, 99, 235, 0.18);
    }

    .icon-btn:hover {
      filter: brightness(0.96);
      transform: translateY(-1px);
    }

    .icon-btn.secondary {
      color: var(--primary);
      background: #f8fafc;
      border: 1px solid var(--line);
      box-shadow: none;
    }

    .icon-btn.success {
      background: linear-gradient(135deg, #ecfdf5, #d1fae5);
      color: var(--green);
      border: 1px solid var(--green-line);
      box-shadow: none;
    }

    .icon-btn.danger {
      background: linear-gradient(135deg, #fef2f2, #fee2e2);
      color: var(--red);
      border: 1px solid var(--red-line);
      box-shadow: none;
    }

    .icon-btn.amber {
      background: linear-gradient(135deg, #fffbeb, #fef3c7);
      color: var(--amber);
      border: 1px solid var(--amber-line);
      box-shadow: none;
    }

    .icon-btn.purple {
      background: linear-gradient(135deg, #f5f3ff, #ede9fe);
      color: var(--purple);
      border: 1px solid var(--purple-line);
      box-shadow: none;
    }

    .icon-btn.cyan {
      background: linear-gradient(135deg, #ecfeff, #cffafe);
      color: var(--cyan);
      border: 1px solid var(--cyan-line);
      box-shadow: none;
    }

    .icon-btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none;
    }

    .icon {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .main {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
      padding: 16px 22px 22px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      overflow: hidden;
    }

    .search-panel {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 15px;
      box-shadow: var(--shadow);
      flex: 0 0 auto;
    }

    .toolbar {
      display: grid;
      grid-template-columns: 1fr 210px 190px 180px auto auto;
      gap: 9px;
      align-items: center;
    }

    .search-input,
    .filter-select,
    .form-input {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid var(--line);
      border-radius: 14px;
      font-size: 14px;
      outline: none;
      background: #ffffff;
      color: var(--text);
      min-height: 42px;
    }

    .search-input:focus,
    .filter-select:focus,
    .form-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.10);
    }

    .error {
      margin-top: 12px;
      padding: 13px;
      border-radius: 14px;
      background: #fef2f2;
      color: #991b1b;
      border: 1px solid #fecaca;
      display: none;
      white-space: pre-wrap;
      font-size: 13px;
    }

    .table-card {
      flex: 1 1 auto;
      min-height: 0;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
    }

    .table-header {
      padding: 13px 16px;
      border-bottom: 1px solid var(--line);
      background: #ffffff;
      flex: 0 0 auto;
    }

    .table-title {
      margin: 0;
      font-size: 16px;
      font-weight: 900;
      color: var(--primary);
    }

    .table-wrapper {
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
      overflow: auto;
      background: #ffffff;
    }

    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      min-width: 1100px;
    }

    thead th {
      position: sticky;
      top: 0;
      z-index: 5;
      text-align: left;
      padding: 12px 13px;
      font-size: 12px;
      color: #374151;
      background: #f9fafb;
      border-bottom: 1px solid var(--line);
      white-space: nowrap;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    tbody td {
      padding: 11px 13px;
      font-size: 13px;
      color: #111827;
      border-bottom: 1px solid #f1f5f9;
      white-space: nowrap;
      vertical-align: middle;
    }

    tbody tr {
      cursor: pointer;
      transition: 0.15s ease;
    }

    tbody tr:hover {
      background: #eff6ff;
    }

    .empty,
    .loading {
      padding: 42px;
      text-align: center;
      color: var(--muted);
      font-weight: 700;
    }

    .loading {
      color: var(--accent);
    }

    mark {
      background: #fef08a;
      color: #111827;
      padding: 0 2px;
      border-radius: 3px;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 8px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 800;
      border: 1px solid var(--gray-line);
      background: var(--gray-bg);
      color: #374151;
      line-height: 1.2;
    }

    .status-badge.active {
      background: var(--green-bg);
      border-color: var(--green-line);
      color: var(--green);
    }

    .status-badge.resign {
      background: var(--red-bg);
      border-color: var(--red-line);
      color: var(--red);
    }

    .profile-overlay,
    .settings-overlay,
    .birthday-overlay {
      position: fixed;
      inset: 0;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(15, 23, 42, 0.45);
      z-index: 100;
      padding: 12px;
    }

    .settings-overlay,
    .birthday-overlay {
      z-index: 120;
    }

    .profile-overlay.active,
    .settings-overlay.active,
    .birthday-overlay.active {
      display: flex;
    }

    .profile-card {
      width: min(1180px, 100%);
      max-height: calc(100vh - 24px);
      background: #ffffff;
      border-radius: 22px;
      box-shadow: 0 30px 100px rgba(15, 23, 42, 0.28);
      border: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .profile-card.capture-mode {
      max-height: none !important;
      overflow: visible !important;
    }

    .profile-card.capture-mode .profile-actions,
    .profile-card.capture-mode .photo-action,
    .profile-card.capture-mode .copy-mini-btn {
      display: none !important;
    }

    .profile-header {
      flex: 0 0 auto;
      display: grid;
      grid-template-columns: 152px 1fr auto;
      gap: 14px;
      padding: 14px;
      background: linear-gradient(135deg, #eff6ff, #ffffff 64%);
      border-bottom: 1px solid var(--line);
      align-items: center;
    }

    .photo-zone {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .profile-photo-box {
      width: 105px;
      height: 126px;
      border-radius: 16px;
      overflow: hidden;
      background: #e5e7eb;
      border: 1px solid #d1d5db;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
    }

    .photo-action {
      width: 39px;
      height: 39px;
      border-radius: 13px;
      flex: 0 0 auto;
    }

    .profile-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .profile-initial {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      color: #ffffff;
      background: linear-gradient(135deg, #2563eb, #0f172a);
      font-size: 30px;
      font-weight: 900;
    }

    .profile-main {
      min-width: 0;
    }

    .profile-kicker {
      color: var(--accent);
      font-size: 10px;
      font-weight: 900;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      margin-bottom: 5px;
    }

    .profile-name {
      margin: 0;
      color: var(--primary);
      font-size: clamp(22px, 3vw, 34px);
      line-height: 1.03;
      font-weight: 900;
      letter-spacing: -0.03em;
      word-break: break-word;
    }

    .profile-subtitle {
      margin: 6px 0 0;
      color: #4b5563;
      font-size: 14px;
      line-height: 1.3;
      word-break: break-word;
    }

    .profile-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 9px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 8px;
      border-radius: 999px;
      background: #f3f4f6;
      color: #374151;
      font-size: 11.5px;
      font-weight: 800;
      border: 1px solid var(--line);
    }

    .badge.blue {
      background: var(--accent-soft);
      color: #1d4ed8;
      border-color: #bfdbfe;
    }

    .badge.green {
      background: var(--green-bg);
      color: var(--green);
      border-color: var(--green-line);
    }

    .profile-actions {
      display: flex;
      flex-direction: column;
      gap: 7px;
      align-items: stretch;
    }

    .profile-body {
      flex: 1 1 auto;
      overflow: hidden;
      padding: 12px 14px 14px;
    }

    .section-title {
      margin: 0 0 9px;
      color: var(--primary);
      font-size: 14px;
      font-weight: 900;
    }

    .detail-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 8px;
    }

    .detail-item {
      border: 1px solid var(--line);
      border-radius: 13px;
      background: #ffffff;
      padding: 8px 9px;
      min-height: 52px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .detail-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .detail-label {
      color: var(--muted);
      font-size: 9px;
      font-weight: 900;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin: 0;
    }

    .detail-value {
      color: #111827;
      font-size: 12px;
      line-height: 1.22;
      word-break: break-word;
      white-space: normal;
    }

    .copy-mini-btn {
      width: 25px;
      height: 25px;
      min-width: 25px;
      padding: 0;
      display: inline-grid;
      place-items: center;
      border-radius: 9px;
      background: #f8fafc;
      color: #334155;
      border: 1px solid var(--line);
      box-shadow: none;
      cursor: pointer;
    }

    .profile-card.layout-executive {
      width: min(980px, 100%);
    }

    .profile-card.layout-executive .profile-header {
      grid-template-columns: 185px 1fr auto;
      background:
        radial-gradient(circle at top right, rgba(37, 99, 235, 0.13), transparent 35%),
        linear-gradient(135deg, #ffffff, #eff6ff);
    }

    .profile-card.layout-executive .profile-photo-box {
      width: 138px;
      height: 168px;
      border-radius: 20px;
    }

    .profile-card.layout-executive .profile-name {
      font-size: clamp(26px, 3.4vw, 42px);
    }

    .profile-card.layout-executive .detail-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .profile-card.layout-minimal {
      width: min(760px, 100%);
    }

    .profile-card.layout-minimal .profile-header {
      grid-template-columns: 92px 1fr auto;
      padding: 12px;
    }

    .profile-card.layout-minimal .profile-photo-box {
      width: 82px;
      height: 98px;
      border-radius: 15px;
    }

    .profile-card.layout-minimal .profile-name {
      font-size: 22px;
    }

    .profile-card.layout-minimal .detail-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .settings-card {
      width: min(560px, 100%);
      background: #ffffff;
      border-radius: 22px;
      padding: 20px;
      box-shadow: 0 30px 100px rgba(15, 23, 42, 0.30);
      border: 1px solid var(--line);
      max-height: 94vh;
      overflow: auto;
    }

    .birthday-card {
      width: min(1120px, 100%);
      background: #ffffff;
      border-radius: 22px;
      padding: 20px;
      box-shadow: 0 30px 100px rgba(15, 23, 42, 0.30);
      border: 1px solid var(--line);
      max-height: 94vh;
      overflow: auto;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      margin-bottom: 16px;
    }

    .modal-title {
      margin: 0;
      font-size: 19px;
      font-weight: 900;
      color: var(--primary);
    }

    .form-group {
      margin-bottom: 14px;
    }

    .form-label {
      display: block;
      margin-bottom: 7px;
      font-size: 13px;
      font-weight: 800;
      color: #374151;
    }

    .form-help {
      margin-top: 6px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.4;
    }

    .logo-preview-wrap {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      padding: 12px;
      border: 1px dashed #cbd5e1;
      border-radius: 16px;
      background: #f8fafc;
    }

    .logo-preview {
      width: 90px;
      height: 90px;
      border-radius: 16px;
      overflow: hidden;
      background: #e2e8f0;
      border: 1px solid #cbd5e1;
      display: grid;
      place-items: center;
      color: #0f172a;
      font-weight: 900;
      font-size: 24px;
      flex: 0 0 auto;
    }

    .logo-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 9px;
      margin-top: 16px;
      flex-wrap: wrap;
    }

    .birthday-toolbar {
      display: grid;
      grid-template-columns: 1fr 190px 170px 160px auto;
      gap: 9px;
      margin-bottom: 12px;
    }

    .birthday-table-wrap {
      max-height: 62vh;
      overflow: auto;
      border: 1px solid var(--line);
      border-radius: 16px;
    }

    .birthday-table {
      min-width: 980px;
    }

    .toast-wrap {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 999;
      display: flex;
      flex-direction: column;
      gap: 10px;
      pointer-events: none;
    }

    .toast {
      min-width: 280px;
      max-width: 360px;
      background: #ffffff;
      border: 1px solid var(--line);
      box-shadow: 0 22px 60px rgba(15, 23, 42, 0.18);
      border-radius: 18px;
      padding: 13px 14px;
      display: grid;
      grid-template-columns: 34px 1fr;
      gap: 10px;
      align-items: start;
      animation: toastIn 0.22s ease;
    }

    .toast-icon {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: var(--accent-soft);
      color: var(--accent);
    }

    .toast.success .toast-icon {
      background: var(--green-bg);
      color: var(--green);
    }

    .toast.error .toast-icon {
      background: var(--red-bg);
      color: var(--red);
    }

    .toast-title {
      font-weight: 900;
      color: var(--primary);
      font-size: 13px;
      margin-bottom: 2px;
    }

    .toast-message {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.35;
    }

    @keyframes toastIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media print {
      body {
        background: #ffffff !important;
      }

      body * {
        visibility: hidden !important;
      }

      .profile-overlay,
      .profile-overlay *,
      .profile-card,
      .profile-card * {
        visibility: visible !important;
      }

      .profile-overlay {
        position: static !important;
        display: block !important;
        padding: 0 !important;
        background: #ffffff !important;
      }

      .profile-card {
        width: 100% !important;
        max-height: none !important;
        border: none !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        overflow: visible !important;
      }

      .profile-body {
        overflow: visible !important;
      }

      .profile-actions,
      .photo-action,
      .copy-mini-btn {
        display: none !important;
      }

      .detail-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      }
    }

    @media (max-width: 1200px) {
      html, body {
        overflow: auto;
      }

      .app {
        height: auto;
        overflow: visible;
      }

      .topbar {
        align-items: flex-start;
        flex-direction: column;
      }

      .header-stats {
        width: 100%;
        justify-content: flex-start;
      }

      .main {
        overflow: visible;
      }

      .toolbar,
      .birthday-toolbar {
        grid-template-columns: 1fr 1fr 1fr;
      }

      .detail-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 720px) {
      .toolbar,
      .birthday-toolbar {
        grid-template-columns: 1fr;
      }

      .brand-title {
        white-space: normal;
        font-size: 18px;
      }

      .header-stat {
        flex: 1;
        min-width: 92px;
      }

      .profile-header {
        grid-template-columns: 1fr;
      }

