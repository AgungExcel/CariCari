  <script>
    let allHeaders = [];
    let allRows = [];
    let filteredRows = [];
    let selectedPhotoFileId = '';
    let selectedPhotoDataUrl = '';
    let uploadedLogoDataUrl = '';
    let currentProfileRow = null;
    let searchTimer = null;

    let birthdayRows = [];
    let filteredBirthdayRows = [];

    let filterHeaders = {
      section: '',
      department: '',
      branch: '',
      status: '',
      employeeType: '',
      birthDate: '',
      position: '',
      exitDate: ''
    };

    let defaultConfig = {
      appTitle: 'Pencarian Cepat Data Karyawan PT Hop Lun Indonesia'
    };

    const profileLayouts = ['compact', 'executive', 'minimal'];
    const MAX_RENDER_ROWS = 1500;

    document.addEventListener('DOMContentLoaded', function () {
      loadConfig();
      reloadData();

      document
        .getElementById('searchInput')
        .addEventListener('input', function () {
          clearTimeout(searchTimer);
          searchTimer = setTimeout(applySearch, 120);
        });
    });

    function loadConfig() {
      google.script.run
        .withSuccessHandler(function (config) {
          defaultConfig = config || defaultConfig;
          applySavedSettings();
        })
        .withFailureHandler(function () {
          applySavedSettings();
        })
        .getAppConfig();
    }

    function applySavedSettings() {
      const savedTitle = localStorage.getItem('appTitle') || defaultConfig.appTitle;
      const savedLogoDataUrl = localStorage.getItem('logoDataUrl') || '';

      document.getElementById('appTitle').textContent = savedTitle || defaultConfig.appTitle;
      document.title = savedTitle || defaultConfig.appTitle;

      renderLogo(savedLogoDataUrl);
      applyProfileLayout(getDefaultProfileLayout());
    }

    function getDefaultProfileLayout() {
      return localStorage.getItem('profileLayout') || 'compact';
    }

    function applyProfileLayout(layout) {
      const card = document.getElementById('profileCard');
      if (!card) return;

      profileLayouts.forEach(item => {
        card.classList.remove('layout-' + item);
      });

      card.classList.add('layout-' + layout);
    }

    function cycleProfileLayout() {
      const current = getDefaultProfileLayout();
      const currentIndex = profileLayouts.indexOf(current);
      const next = profileLayouts[(currentIndex + 1) % profileLayouts.length];

      localStorage.setItem('profileLayout', next);
      applyProfileLayout(next);

      showToast('Layout profil diganti ke ' + next.toUpperCase() + '.', 'success', 'Layout');
    }

    function renderLogo(source) {
      const logo = document.getElementById('appLogo');

      if (source) {
        logo.innerHTML = `<img src="${escapeAttribute(source)}" onerror="this.parentNode.textContent='HL'">`;
      } else {
        logo.textContent = 'HL';
      }
    }

    function openSettings() {
      const savedTitle = localStorage.getItem('appTitle') || defaultConfig.appTitle || '';
      uploadedLogoDataUrl = localStorage.getItem('logoDataUrl') || '';

      document.getElementById('settingAppTitle').value = savedTitle;
      document.getElementById('settingProfileLayout').value = getDefaultProfileLayout();
      document.getElementById('settingLogoFile').value = '';

      refreshSettingsPreview();

      document.getElementById('settingsOverlay').classList.add('active');
      document.body.classList.add('lock-scroll');
    }

    function closeSettings() {
      document.getElementById('settingsOverlay').classList.remove('active');

      if (
        !document.getElementById('profileOverlay').classList.contains('active') &&
        !document.getElementById('birthdayOverlay').classList.contains('active')
      ) {
        document.body.classList.remove('lock-scroll');
      }
    }

    function settingsOverlayClick(event) {
      if (event.target.id === 'settingsOverlay') {
        closeSettings();
      }
    }

    function handleLogoUpload(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      resizeImageFile(file, 512, function (dataUrl) {
        uploadedLogoDataUrl = dataUrl;
        refreshSettingsPreview();
      });
    }

    function resizeImageFile(file, maxSize, callback) {
      const reader = new FileReader();

      reader.onload = function (e) {
        const img = new Image();

        img.onload = function () {
          let width = img.width;
          let height = img.height;

          if (width > height && width > maxSize) {
            height = Math.round(height * (maxSize / width));
            width = maxSize;
          } else if (height > maxSize) {
            width = Math.round(width * (maxSize / height));
            height = maxSize;
          }

          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;

          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);

          callback(canvas.toDataURL('image/png'));
        };

        img.src = e.target.result;
      };

      reader.readAsDataURL(file);
    }

    function refreshSettingsPreview() {
      const preview = document.getElementById('settingsLogoPreview');

      if (uploadedLogoDataUrl) {
        preview.innerHTML = `<img src="${escapeAttribute(uploadedLogoDataUrl)}" onerror="this.parentNode.textContent='HL'">`;
      } else {
        preview.textContent = 'HL';
      }
    }

    function saveSettings() {
      const appTitle = document.getElementById('settingAppTitle').value.trim();
      const layout = document.getElementById('settingProfileLayout').value || 'compact';

      localStorage.setItem('appTitle', appTitle || defaultConfig.appTitle || '');
      localStorage.setItem('profileLayout', layout);

      if (uploadedLogoDataUrl) {
        localStorage.setItem('logoDataUrl', uploadedLogoDataUrl);
      } else {
        localStorage.removeItem('logoDataUrl');
      }

      applySavedSettings();
      closeSettings();
      showToast('Pengaturan berhasil disimpan.', 'success', 'Berhasil');
    }

    function resetSettings() {
      localStorage.removeItem('appTitle');
      localStorage.removeItem('logoDataUrl');
      localStorage.removeItem('profileLayout');
      uploadedLogoDataUrl = '';
      applySavedSettings();
      closeSettings();
      showToast('Pengaturan dikembalikan ke default.', 'success', 'Reset');
    }

    function reloadData() {
      hideError();

      document.getElementById('tableContainer').className = 'loading';
      document.getElementById('tableContainer').innerHTML = 'Memuat data...';

      google.script.run
        .withSuccessHandler(function (result) {
          allHeaders = result.headers || [];
          allRows = result.rows || [];
          filteredRows = [...allRows];

          detectFilterHeaders();
          buildFilters();
          updateHeaderStats();
          applySearch();

          showToast('Data dan foto berhasil dimuat.', 'success', 'Refresh');
        })
        .withFailureHandler(function (error) {
          showError(error && error.message ? error.message : String(error));
          document.getElementById('tableContainer').className = 'empty';
          document.getElementById('tableContainer').innerHTML = 'Gagal memuat data.';
        })
        .getSheetData();
    }

    function detectFilterHeaders() {
      filterHeaders.section = findHeaderByAliases([
        'section',
        'seksi',
        'departemen',
        'department',
        'divisi',
        'division',
        'bagian',
        'dept'
      ]);

      filterHeaders.department = filterHeaders.section;

      filterHeaders.branch = findHeaderByAliases([
        'cabang',
        'branch',
        'unit',
        'plant',
        'lokasi',
        'location'
      ]);

      filterHeaders.status = findHeaderByAliases([
        'status',
        'status karyawan',
        'employee status',
        'jenis karyawan',
        'kategori',
        'kategori karyawan',
        'employee type',
        'type'
      ]);

      filterHeaders.employeeType = findHeaderByAliases([
        'status',
        'jenis karyawan',
        'kategori',
        'kategori karyawan',
        'employee type',
        'tipe karyawan',
        'type'
      ]);

      filterHeaders.birthDate = findHeaderByAliases([
        'tanggal lahir',
        'tgl lahir',
        'tanngal lahir',
        'tanggallahir',
        'tanggal_lahir',
        'date of birth',
        'birth date',
        'birthdate',
        'dob',
        'lahir'
      ]);

      filterHeaders.position = findHeaderByAliases([
        'jabatan',
        'posisi',
        'position',
        'job title',
        'title'
      ]);

      filterHeaders.exitDate = findHeaderByAliases([
        'tanggal keluar',
        'tgl keluar',
        'resign date',
        'date resign',
        'tanggal resign',
        'keluar'
      ]);
    }

    function findHeaderByAliases(aliases) {
      const normalizedHeaders = allHeaders.map(normalizeText);
      const normalizedAliases = aliases.map(normalizeText);

      for (let i = 0; i < normalizedHeaders.length; i++) {
        if (normalizedAliases.includes(normalizedHeaders[i])) {
          return allHeaders[i];
        }
      }

      for (let i = 0; i < normalizedHeaders.length; i++) {
        for (const alias of normalizedAliases) {
          if (normalizedHeaders[i].includes(alias)) {
            return allHeaders[i];
          }
        }
      }

      return '';
    }

    function buildFilters() {
      buildSelectFilter('departmentFilter', filterHeaders.section, 'Semua Section');
      buildSelectFilter('branchFilter', filterHeaders.branch, 'Semua Cabang');
      buildSelectFilter('statusFilter', filterHeaders.status, 'Semua Status');
    }

    function buildSelectFilter(selectId, headerName, defaultLabel) {
      const select = document.getElementById(selectId);
      select.innerHTML = `<option value="">${defaultLabel}</option>`;

      if (!headerName) {
        select.disabled = true;
        return;
      }

      select.disabled = false;

      const values = [...new Set(
        allRows
          .map(row => String(row[headerName] || '').trim())
          .filter(Boolean)
      )].sort((a, b) => a.localeCompare(b));

      values.forEach(function (value) {
        const option = document.createElement('option');
        option.value = value;
        option.textContent = value;
        select.appendChild(option);
      });
    }

    function updateHeaderStats() {
      const counts = {
        worker: 0,
        staff: 0,
        manager: 0,
        expat: 0,
        unit1: 0,
        unit2: 0
      };

      allRows.forEach(function (row) {
        const type = getEmployeeType(row);
        const branch = normalizeText(filterHeaders.branch ? row[filterHeaders.branch] : '');

        if (type === 'WORKER') counts.worker++;
        if (type === 'STAFF') counts.staff++;
        if (type === 'MANAGER') counts.manager++;
        if (type === 'EXPAT') counts.expat++;

        if (branch.includes('unit 1') || branch.includes('unit1')) counts.unit1++;
        if (branch.includes('unit 2') || branch.includes('unit2')) counts.unit2++;
      });

      document.getElementById('totalSummary').textContent = allRows.length;
      document.getElementById('workerSummary').textContent = counts.worker;
      document.getElementById('staffSummary').textContent = counts.staff;
      document.getElementById('managerSummary').textContent = counts.manager;
      document.getElementById('expatSummary').textContent = counts.expat;
      document.getElementById('unit1Summary').textContent = counts.unit1;
      document.getElementById('unit2Summary').textContent = counts.unit2;
    }

    function getEmployeeType(row) {
      const sources = [];

      if (filterHeaders.employeeType) sources.push(row[filterHeaders.employeeType]);
      if (filterHeaders.status) sources.push(row[filterHeaders.status]);
      if (filterHeaders.position) sources.push(row[filterHeaders.position]);

      const text = normalizeText(sources.join(' '));

      if (text.includes('expat') || text.includes('expert') || text.includes('expatriate')) return 'EXPAT';
      if (text.includes('manager') || text.includes('mgr') || text.includes('manajer')) return 'MANAGER';
      if (text.includes('worker') || text.includes('operator') || text.includes('opr') || text.includes('buruh')) return 'WORKER';
      if (text.includes('staff') || text.includes('staf')) return 'STAFF';

      return '';
    }

    function applySearch() {
      const keyword = normalizeText(document.getElementById('searchInput').value);
      const sectionValue = document.getElementById('departmentFilter').value;
      const branchValue = document.getElementById('branchFilter').value;
      const statusValue = document.getElementById('statusFilter').value;

      const terms = keyword.split(' ').filter(Boolean);

      filteredRows = allRows.filter(function (row) {
        const rowText = normalizeText(
          allHeaders.map(header => row[header] || '').join(' ')
        );

        const matchKeyword = !keyword || terms.every(term => rowText.includes(term));

        const matchSection =
          !sectionValue ||
          !filterHeaders.section ||
          String(row[filterHeaders.section] || '') === sectionValue;

        const matchBranch =
          !branchValue ||
          !filterHeaders.branch ||
          String(row[filterHeaders.branch] || '') === branchValue;

        const matchStatus =
          !statusValue ||
          !filterHeaders.status ||
          String(row[filterHeaders.status] || '') === statusValue;

        return matchKeyword && matchSection && matchBranch && matchStatus;
      });

      document.getElementById('filteredSummary').textContent = filteredRows.length;
      renderTable(keyword);
    }

    function renderTable(keyword) {
      const container = document.getElementById('tableContainer');
      container.className = '';

      if (!allHeaders.length) {
        container.className = 'empty';
        container.innerHTML = 'Tidak ada header/kolom di sheet.';
        return;
      }

      if (!filteredRows.length) {
        container.className = 'empty';
        container.innerHTML = 'Data tidak ditemukan.';
        return;
      }

      const rowsToRender = filteredRows.slice(0, MAX_RENDER_ROWS);

      let html = '<table>';
      html += '<thead><tr>';

      allHeaders.forEach(function (header) {
        html += '<th>' + escapeHtml(header) + '</th>';
      });

      html += '</tr></thead>';
      html += '<tbody>';

      rowsToRender.forEach(function (row, index) {
        html += '<tr onclick="openProfile(' + index + ')">';

        allHeaders.forEach(function (header) {
          html += '<td>' + renderTableCell(row, header, keyword) + '</td>';
        });

        html += '</tr>';
      });

      html += '</tbody></table>';

      if (filteredRows.length > MAX_RENDER_ROWS) {
        html += `<div class="empty">Menampilkan ${MAX_RENDER_ROWS} dari ${filteredRows.length} data.</div>`;
      }

      container.innerHTML = html;
    }

    function renderTableCell(row, header, keyword) {
      const value = row[header] == null ? '' : String(row[header]);

      if (filterHeaders.status && header === filterHeaders.status) {
        return renderStatusBadge(value, row);
      }

      return highlightText(value, keyword);
    }

