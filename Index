    async function copyProfileCardImage() {
      const card = document.getElementById('profileCard');

      if (!card) {
        showToast('Profil belum tersedia.', 'error', 'Gagal');
        return;
      }

      if (typeof html2canvas === 'undefined') {
        showToast('Library copy gambar belum termuat. Periksa koneksi internet.', 'error', 'Gagal');
        return;
      }

      try {
        showToast('Sedang membuat gambar profil...', 'success', 'Memproses');

        card.classList.add('capture-mode');

        await new Promise(resolve => setTimeout(resolve, 180));

        const canvas = await html2canvas(card, {
          backgroundColor: '#ffffff',
          scale: 2,
          useCORS: true,
          allowTaint: true,
          logging: false
        });

        card.classList.remove('capture-mode');

        canvas.toBlob(async function (blob) {
          if (!blob) {
            showToast('Gagal membuat gambar profil.', 'error', 'Gagal');
            return;
          }

          try {
            if (navigator.clipboard && window.ClipboardItem) {
              await navigator.clipboard.write([
                new ClipboardItem({ 'image/png': blob })
              ]);

              showToast('Gambar profil berhasil disalin.', 'success', 'Berhasil');
            } else {
              downloadProfileImageFromCanvas(canvas);
              showToast('Browser tidak mendukung copy gambar. File PNG didownload otomatis.', 'success', 'Downloaded');
            }
          } catch (error) {
            downloadProfileImageFromCanvas(canvas);
            showToast('Copy clipboard gagal. File PNG didownload otomatis.', 'success', 'Downloaded');
          }
        }, 'image/png');
      } catch (error) {
        card.classList.remove('capture-mode');
        showToast('Gagal copy gambar profil.', 'error', 'Gagal');
      }
    }

    function downloadProfileImageFromCanvas(canvas) {
      const profile = currentProfileRow && currentProfileRow._profile ? currentProfileRow._profile : {};
      const fileName = 'Profil_' + String(profile.id || 'Karyawan').replace(/[^a-z0-9]/gi, '_') + '.png';

      const link = document.createElement('a');
      link.href = canvas.toDataURL('image/png');
      link.download = fileName;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

