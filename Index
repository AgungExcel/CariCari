    function renderStatusBadge(value, row) {
      const cleanValue = String(value || '-').trim() || '-';
      const statusClass = getStatusClass(cleanValue, row);
      return `<span class="status-badge ${statusClass}">${escapeHtml(cleanValue)}</span>`;
    }

    function getDisplayStatus(row) {
      if (filterHeaders.status) {
        return String(row[filterHeaders.status] || '-').trim() || '-';
      }

      if (isResigned(row)) return 'KELUAR';
      return 'AKTIF';
    }

    function isResigned(row) {
      if (!row) return false;

      if (filterHeaders.exitDate) {
        const exitValue = String(row[filterHeaders.exitDate] || '').trim();
        if (exitValue && exitValue !== '-') return true;
      }

      const statusValue = filterHeaders.status ? String(row[filterHeaders.status] || '') : '';
      const v = normalizeText(statusValue);

      return (
        v.includes('resign') ||
        v.includes('keluar') ||
        v.includes('non aktif') ||
        v.includes('nonaktif') ||
        v.includes('inactive') ||
        v.includes('tidak aktif')
      );
    }

    function getStatusClass(value, row) {
      if (isResigned(row)) return 'resign';

      const v = normalizeText(value);

      if (
        v.includes('aktif') ||
        v.includes('active') ||
        v.includes('staff') ||
        v.includes('worker') ||
        v.includes('manager') ||
        v.includes('expat') ||
        v.includes('tetap') ||
        v.includes('kontrak') ||
        v.includes('probation')
      ) {
        return 'active';
      }

      return '';
    }

    function getSectionValue(row) {
      if (filterHeaders.section) {
        return String(row[filterHeaders.section] || '-').trim() || '-';
      }

      const profile = row._profile || {};
      return profile.section || profile.department || '-';
