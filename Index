          tglLahir: birthText || '-',
          usia: profile.age || '-',
          masaKerja: profile.workPeriod || '-',
          status: getDisplayStatus(row),
          cabang: profile.branch || '-',
          birthdayDate: birthdayThisWeek,
          row: row
